# Copier vers .env et adapter. Ne jamais committer .env.

# API
API_HOST=0.0.0.0
API_PORT=8080
API_ENV=development
API_CORS_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_USER=openstudio
POSTGRES_PASSWORD=openstudio_dev
POSTGRES_DB=openstudio
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://openstudio:openstudio_dev@localhost:5432/openstudio?sslmode=disable

# Auth (changer en production)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Media
MEDIA_STORAGE=local
MEDIA_LOCAL_PATH=./data/media
MEDIA_MAX_UPLOAD_BYTES=52428800
