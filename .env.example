# Copy to .env and adjust. Never commit .env.

# API
API_HOST=0.0.0.0
API_PORT=8080
API_ENV=development
API_CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# PostgreSQL
POSTGRES_USER=walls
POSTGRES_PASSWORD=walls_dev
POSTGRES_DB=walls
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://walls:walls_dev@localhost:5432/walls?sslmode=disable

# Auth. Outside development the secret must be 32+ random characters.
# The example value below is rejected when API_ENV=production.
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_TTL=15m

# Proxies allowed to set X-Forwarded-For. Do not set this to 0.0.0.0/0.
API_TRUSTED_PROXIES=127.0.0.1,::1

# Rate limit register/login (per IP)
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW=1m

# Media
MEDIA_STORAGE=local
MEDIA_LOCAL_PATH=./data/media
MEDIA_MAX_UPLOAD_BYTES=52428800
TRACK_DAILY_UPLOAD_LIMIT=20
