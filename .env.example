# Copy to .env and adjust. Never commit .env.

# API
API_HOST=0.0.0.0
API_PORT=8080
API_ENV=development
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL
POSTGRES_USER=walls
POSTGRES_PASSWORD=walls_dev
POSTGRES_DB=walls
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://walls:walls_dev@localhost:5432/walls?sslmode=disable

# Auth (change in production)
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Rate limit register/login (per IP)
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW=1m

# Media
MEDIA_STORAGE=local
MEDIA_LOCAL_PATH=./data/media
MEDIA_MAX_UPLOAD_BYTES=52428800
TRACK_DAILY_UPLOAD_LIMIT=20
