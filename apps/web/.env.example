# Leave empty in local dev: the browser talks to the same origin and
# next.config.ts rewrites /api/* to the Go API (no CORS issues).
# Override only if the API is on another host.
NEXT_PUBLIC_API_URL=

# Where Next proxies /api (server-side only, not exposed to the browser).
WALLS_API_PROXY=http://127.0.0.1:8080
